{% extends 'layouts/app.twig' %}

{% block content %}
    <section class="-mx-5 -mt-5 border-b border-[var(--border)] bg-[var(--background)] px-5 pb-5 pt-5 lg:-mx-8 lg:-mt-8 lg:px-8 lg:pt-8">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-primary text-3xl font-bold">
                        {{ t('dashboard.greeting') }}, {{ user.name }}!
                    </p>
                    <p class="mt-2 max-w-2xl text-sm text-secondary">
                        {{ t('dashboard.subtitle') }}:
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 xl:min-w-[680px]">
                <div class="rounded border border-[var(--border)] bg-[var(--surface)] p-3">
                    <p class="text-xs text-secondary">{{ t('dashboard.balance.cycle_balance') }}</p>
                    <strong class="mt-1 block text-xl font-semibold text-primary" data-viewed-cycle-balance>{{ dashboard.currentCycle.balanceLabel }}</strong>
                </div>
                <div class="rounded border border-[var(--border)] bg-[var(--surface)] p-3">
                    <p class="text-xs text-secondary">{{ t('dashboard.balance.committed') }}</p>
                    <strong class="mt-1 block text-xl font-semibold text-[var(--surface-contrast)]">{{ dashboard.balance.commitedLabel }}</strong>
                </div>
            </div>
        </div>

        <div class="mt-5">
            {% if dashboard_feedback|default(null) %}
                <div class="mb-4 flex items-start gap-3 rounded border border-[var(--primary)] bg-[var(--primary-muted)] px-3 py-3 text-sm text-primary" role="alert">
                    <i class="fa-solid fa-circle-check mt-0.5"></i>
                    <span>{{ dashboard_feedback.message }}</span>
                </div>
            {% endif %}

            <div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-secondary">{{ t('dashboard.cycle.progress') }} <span data-viewed-cycle-progress-label>{{ dashboard.currentCycle.label }}</span></span>
                    <span class="text-purple" data-viewed-cycle-progress-value>{{ dashboard.currentCycle.progress }}%</span>
                </div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--muted)]">
                    <div class="h-full rounded-full bg-[var(--primary)] transition-all duration-300" style="width: {{ dashboard.currentCycle.progress }}%" data-viewed-cycle-progress-bar></div>
                </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-1" aria-label="{{ t('dashboard.actions_label') }}">
                <button type="button" class="group flex h-9 items-center gap-1.5 overflow-hidden rounded px-2 text-sm text-primary transition hover:bg-[var(--muted)] focus-visible:bg-[var(--muted)] focus-visible:outline-none disabled:cursor-wait disabled:opacity-50" title="{{ t('dashboard.transactions.refresh') }}" aria-label="{{ t('dashboard.transactions.refresh') }}" data-refresh-home>
                    <i class="fa-solid fa-rotate-right flex w-5 justify-center"></i>
                    <span class="max-w-0 -translate-x-1 overflow-hidden whitespace-nowrap opacity-0 transition-all duration-200 ease-out group-hover:max-w-28 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:max-w-28 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">{{ t('common.actions.refresh') }}</span>
                </button>

                <button type="button" class="group flex h-9 items-center gap-1.5 overflow-hidden rounded px-2 text-sm text-primary transition hover:bg-[var(--muted)] focus-visible:bg-[var(--muted)] focus-visible:outline-none disabled:cursor-wait disabled:opacity-50" title="{{ t('dashboard.transactions.export') }}" aria-label="{{ t('dashboard.transactions.export') }}" data-print-cycle data-print-url="{{ base_url }}/dashboard/cycle/print/">
                    <i class="fa-solid fa-download flex w-5 justify-center"></i>
                    <span class="max-w-0 -translate-x-1 overflow-hidden whitespace-nowrap opacity-0 transition-all duration-200 ease-out group-hover:max-w-24 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:max-w-24 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">{{ t('common.actions.export') }}</span>
                </button>

                <form method="post" action="{{ base_url }}/dashboard/cycle/close/" data-confirm-form data-confirm-preset="close-cycle">
                    <button type="submit" class="group flex h-9 items-center gap-1.5 overflow-hidden rounded px-2 text-sm text-primary transition hover:bg-[var(--muted)] focus-visible:bg-[var(--muted)] focus-visible:outline-none disabled:cursor-wait disabled:opacity-60" title="{{ t('dashboard.cycle.close') }}" aria-label="{{ t('dashboard.cycle.close') }}">
                        <i class="fa-solid fa-circle-check flex w-5 justify-center"></i>
                        <span class="max-w-0 -translate-x-1 overflow-hidden whitespace-nowrap opacity-0 transition-all duration-200 ease-out group-hover:max-w-32 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:max-w-32 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">{{ t('dashboard.cycle.close') }}</span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section class="mt-8">
        <div class="space-y-6">
            <nav class="flex items-center justify-between gap-3" aria-label="{{ t('dashboard.navigation_label') }}">
                <button type="button" class="flex items-center gap-2 rounded px-3 py-2 text-sm text-primary transition hover:bg-[var(--muted)] disabled:cursor-wait disabled:opacity-50" data-cycle-previous>
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>{{ t('dashboard.cycle.previous') }}</span>
                </button>
                <button type="button" class="flex items-center gap-2 rounded px-3 py-2 text-sm text-primary transition hover:bg-[var(--muted)] disabled:cursor-wait disabled:opacity-50" data-cycle-next>
                    <span>{{ t('dashboard.cycle.next') }}</span>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </nav>

            <section class="rounded border border-[var(--border)] bg-[var(--surface)]" data-cycle-filter-panel>
                <div class="grid grid-cols-1 items-end gap-3 p-3 transition-[max-height,padding] duration-300 md:grid-cols-[minmax(150px,1fr)_auto_auto_auto]" aria-label="{{ t('dashboard.filters_label') }}" data-cycle-filter-content>
                    <div data-select data-select-placeholder="{{ t('common.placeholders.all') }}" data-cycle-filter-entity>
                    <label class="text-xs text-secondary">{{ t('common.filters.entity') }}</label>
                    <input type="hidden" value="" data-select-input>
                    <button type="button" class="mt-1 flex h-9 w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-[var(--background)] px-3 py-2 text-left text-sm leading-[21px] text-primary transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label>{{ t('common.placeholders.all') }}</span>
                        <i class="fa-solid fa-chevron-down text-xs text-secondary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--muted)] hover:text-primary" data-select-option data-value="" data-value-label="{{ t('common.placeholders.all') }}" aria-selected="true">
                            {{ t('common.placeholders.all') }}
                        </button>
                    </div>
                </div>
                <div>
                    <span class="text-xs text-secondary">{{ t('common.filters.type') }}</span>
                    <div class="mt-1 flex h-9 items-center gap-2" data-cycle-filter-type>
                        <button type="button" class="badge flex items-center gap-1.5 border border-[var(--primary)] !bg-transparent !px-2.5 !py-1 !text-[11px] font-medium transition hover:border-[var(--primary)]" style="color: var(--primary);" data-cycle-filter-type-option data-type="I" aria-pressed="true">
                            <i class="fa-solid fa-check text-[10px]" data-cycle-filter-type-icon></i>
                            <span>{{ t('common.types.income') }}</span>
                        </button>
                        <button type="button" class="badge flex items-center gap-1.5 border border-[var(--primary)] !bg-transparent !px-2.5 !py-1 !text-[11px] font-medium transition hover:border-[var(--primary)]" style="color: var(--primary);" data-cycle-filter-type-option data-type="E" aria-pressed="true">
                            <i class="fa-solid fa-check text-[10px]" data-cycle-filter-type-icon></i>
                            <span>{{ t('common.types.expense') }}</span>
                        </button>
                    </div>
                </div>
                <div>
                    <span class="text-xs text-secondary">{{ t('common.filters.status') }}</span>
                    <div class="mt-1 flex h-9 items-center justify-between gap-2">
                        <div class="flex items-center gap-2" data-cycle-filter-status>
                            <button type="button" class="badge flex items-center gap-1.5 border border-[var(--primary)] !bg-transparent !px-2.5 !py-1 !text-[11px] font-medium transition hover:border-[var(--primary)]" style="color: var(--primary);" data-cycle-filter-status-option data-status="paid" aria-pressed="true">
                                <i class="fa-solid fa-check text-[10px]" data-cycle-filter-status-icon></i>
                                <span>{{ t('common.status.paid') }}</span>
                            </button>
                            <button type="button" class="badge flex items-center gap-1.5 border border-[var(--primary)] !bg-transparent !px-2.5 !py-1 !text-[11px] font-medium transition hover:border-[var(--primary)]" style="color: var(--primary);" data-cycle-filter-status-option data-status="pending" aria-pressed="true">
                                <i class="fa-solid fa-check text-[10px]" data-cycle-filter-status-icon></i>
                                <span>{{ t('common.status.pending') }}</span>
                            </button>
                        </div>
                        <button type="button" class="flex h-9 w-9 items-center justify-center rounded text-primary transition hover:bg-[var(--muted)] focus-visible:bg-[var(--muted)] focus-visible:outline-none md:hidden" title="{{ t('common.filters.clear') }}" aria-label="{{ t('common.filters.clear') }}" data-cycle-filter-clear>
                            <i class="fa-solid fa-filter-circle-xmark"></i>
                        </button>
                    </div>
                </div>
                <button type="button" class="hidden h-9 w-9 items-center justify-center rounded text-primary transition hover:bg-[var(--muted)] focus-visible:bg-[var(--muted)] focus-visible:outline-none md:flex" title="{{ t('common.filters.clear') }}" aria-label="{{ t('common.filters.clear') }}" data-cycle-filter-clear>
                    <i class="fa-solid fa-filter-circle-xmark"></i>
                </button>
            </div>
            </section>
            <article class="relative rounded border border-[var(--border)] bg-[var(--surface)] p-5" data-cycle-card data-cycle-url="{{ base_url }}/dashboard/cycle/" data-transaction-delete-url="{{ base_url }}/transactions/delete/" data-cycle-start="{{ dashboard.currentCycle.start|e('html_attr') }}" data-cycle-end="{{ dashboard.currentCycle.end|e('html_attr') }}">
                <header>
                    <button type="button" class="grid w-full gap-4 text-left md:grid-cols-[auto_1fr_auto_auto] md:items-center" data-cycle-toggle aria-expanded="true">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--primary)]">
                            <span class="text-[var(--primary-contrast)] text-lg font-semibold" data-cycle-start-day>{{ dashboard.currentCycle.startDayLabel }}</span>
                        </div>
                        <div>
                            <h2 class="text-xl font-semibold text-primary" data-cycle-label>{{ dashboard.currentCycle.label }}</h2>
                            <p class="mt-1 text-sm text-[var(--muted-contrast)]" data-cycle-description>{{ t('dashboard.cycle.current_until_next_income') }}</p>
                        </div>
                        <div class="grid grid-cols-3 gap-3 text-right text-xs md:min-w-[360px]">
                            <div>
                                <p class="text-secondary">{{ t('dashboard.cycle.income') }}</p>
                                <strong class="block text-sm text-primary" data-cycle-income>{{ dashboard.currentCycle.incomeLabel }}</strong>
                            </div>
                            <div>
                                <p class="text-secondary">{{ t('dashboard.cycle.expenses') }}</p>
                                <strong class="block text-sm text-purple" data-cycle-expenses>{{ dashboard.currentCycle.expensesLabel }}</strong>
                            </div>
                            <div>
                                <p class="text-secondary">{{ t('dashboard.cycle.remaining') }}</p>
                                <strong class="block text-sm text-[var(--surface-contrast)]" data-cycle-balance>{{ dashboard.currentCycle.balanceLabel }}</strong>
                            </div>
                        </div>
                        <span class="flex h-9 w-9 items-center justify-center rounded text-primary transition hover:bg-[var(--muted)] hidden md:flex" aria-hidden="true">
                            <i class="fa-solid fa-chevron-up transition-transform duration-200" data-cycle-icon></i>
                        </span>
                    </button>
                </header>

                <div class="mt-5 space-y-3 pl-0 transition-[max-height,margin-top] duration-300 ease-in-out md:pl-20" data-cycle-content>
                    {% for transaction in dashboard.currentCycle.transactions %}
                        <div class="group relative flex items-center gap-2 overflow-hidden rounded md:block md:overflow-visible" {% if not transaction.is_virtual %}data-swipe-transaction{% endif %}>
                            {% if not transaction.is_virtual %}
                                <div class="absolute inset-y-0 right-0 flex w-24 items-center justify-end rounded border border-[var(--border)] bg-[var(--muted)] pr-5 text-[var(--primary)] md:hidden" aria-hidden="true">
                                    <i class="fa-regular fa-trash-can"></i>
                                </div>
                                <form method="post" action="{{ base_url }}/transactions/delete/" class="hidden shrink-0 md:absolute md:-left-12 md:top-1/2 md:flex md:-translate-y-1/2">
                                    <input type="hidden" name="id" value="{{ transaction.id|e('html_attr') }}">
                                    <button type="submit" class="flex h-9 w-9 cursor-pointer items-center justify-center text-secondary" aria-label="{{ t('dashboard.transactions.delete') }}" title="{{ t('dashboard.transactions.delete') }}" data-delete-button>
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </form>
                            {% else %}
                                <span class="hidden h-9 w-9 shrink-0 md:absolute md:-left-12 md:top-1/2 md:block md:-translate-y-1/2"></span>
                            {% endif %}

                            <button type="button" class="relative z-10 grid min-w-0 flex-1 touch-pan-y gap-3 rounded border border-[var(--border)] bg-[var(--surface-alt)] p-3 text-left transition-transform md:w-full {% if transaction.paid %}opacity-80{% endif %} sm:grid-cols-[1fr_auto] sm:items-center" data-edit-transaction data-swipe-card data-transaction-id="{{ transaction.id|default('')|e('html_attr') }}" {% if transaction.is_virtual %}data-transaction-payload="{{ transaction|json_encode|e('html_attr') }}"{% endif %}>
                                <div class="flex items-center gap-3">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-full text-light" style="background-color: {{ transaction.category.color|e('html_attr') }}">
                                        <i class="{{ transaction.category.icon|e('html_attr') }}"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-medium text-[var(--surface-contrast)]">{{ transaction.title }}</h3>
                                        <p class="text-xs text-secondary">{{ transaction.meta_label }}</p>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between gap-4 sm:block sm:text-right">
                                    <span class="text-xs text-secondary">{{ transaction.date_label }}</span>
                                    <strong class="block text-sm {% if transaction.type == 'I' %}text-primary{% else %}text-[var(--surface-contrast)]{% endif %}">{{ transaction.amount_label }}</strong>
                                    <span class="badge {% if transaction.is_virtual %}badge-scheduled{% endif %}">{{ transaction.status_label }}</span>
                                </div>
                            </button>
                        </div>
                    {% else %}
                        <div class="rounded border border-[var(--border)] bg-[var(--surface-alt)] p-4 text-sm text-secondary">
                            {{ t('dashboard.transactions.empty') }}
                        </div>
                    {% endfor %}
                </div>
            </article>

            <article class="rounded border border-[var(--border)] bg-[var(--surface)] p-5">
                <div class="grid gap-8 md:grid-cols-2">
                    <section>
                        <h2 class="font-semibold text-primary">{{ t('dashboard.charts.expenses_by_entity') }}</h2>
                        <div class="mt-4 space-y-4" data-entity-summary>
                            {% for item in dashboard.currentCycle.entitySummary %}
                                <div>
                                    <div class="flex items-center justify-between gap-4 text-sm text-secondary">
                                        <span class="truncate">{{ item.label }}</span>
                                        <strong>{{ item.amountLabel }}</strong>
                                    </div>
                                    <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[var(--muted)]">
                                        <div class="h-full rounded-full bg-[var(--primary)] transition-all duration-300" style="width: {{ item.percentage }}%"></div>
                                    </div>
                                </div>
                            {% else %}
                                <p class="text-sm text-secondary">{{ t('dashboard.charts.empty_expenses') }}</p>
                            {% endfor %}
                        </div>
                    </section>

                    <section>
                        <h2 class="font-semibold text-primary">{{ t('dashboard.charts.expenses_by_category') }}</h2>
                        <div class="mt-4 space-y-4" data-category-summary>
                            {% for item in dashboard.currentCycle.categorySummary %}
                                <div>
                                    <div class="flex items-center justify-between gap-4 text-sm text-secondary">
                                        <span class="truncate">{{ item.label }}</span>
                                        <strong>{{ item.amountLabel }}</strong>
                                    </div>
                                    <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-[var(--muted)]">
                                        <div class="h-full rounded-full bg-[var(--primary)] transition-all duration-300" style="width: {{ item.percentage }}%"></div>
                                    </div>
                                </div>
                            {% else %}
                                <p class="text-sm text-secondary">{{ t('dashboard.charts.empty_expenses') }}</p>
                            {% endfor %}
                        </div>
                    </section>
                </div>
            </article>
        </div>
    </section>
{% endblock %}

{% block scripts %}
    <script type="application/json" data-cycle-initial-transactions>{{ dashboard.currentCycle.transactions|json_encode|raw }}</script>
    <script src="{{ base_url }}/assets/js/home.js"></script>
{% endblock %}
