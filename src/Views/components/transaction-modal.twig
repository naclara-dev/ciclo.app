<dialog id="transaction-modal" class="modal fixed top-1/2 left-1/2 w-[min(92vw,760px)] -translate-x-1/2 -translate-y-1/2 scale-95 rounded-lg border border-[var(--secondary)] bg-[var(--surface)] p-0 text-[var(--surface-contrast)] opacity-0 shadow-xl transition duration-200 backdrop:bg-[var(--overlay)]" data-transaction-modal data-transaction-find-url="{{ base_url }}/transactions/find/" data-default-wallet-id="{{ user_settings.default_wallet_id|default('')|e('html_attr') }}" data-default-entity-id="{{ user_settings.default_entity_id|default('')|e('html_attr') }}" data-default-payment-method-id="{{ user_settings.default_payment_method_id|default('')|e('html_attr') }}" data-default-type="{{ user_settings.default_type|default('')|e('html_attr') }}">
    <form method="post" action="{{ base_url }}/transactions/store" class="validate" data-transaction-form>
        <div class="flex items-center justify-between px-6 py-4">
            <div>
                <h2 class="text-xl font-bold text-primary" data-transaction-modal-title>{{ t('transactions.new') }}</h2>
                <p class="mt-1 text-xs text-[var(--surface-contrast)] opacity-70">{{ t('transactions.modal_description') }}</p>
            </div>
            <button type="button" class="modal-close flex h-9 w-9 items-center justify-center rounded text-primary transition hover:bg-[var(--secondary)]" aria-label="{{ t('common.actions.close') }}">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-5 px-6 py-5">
            <input type="hidden" name="id">

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {# Declara o combobox de tipo da transação #}
                <div class="form-group" data-select data-select-name="type" data-select-placeholder="{{ t('common.placeholders.choose_type') }}">
                    <label>{{ t('common.fields.type') }}</label>
                    <input type="hidden" name="type" data-type="required" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.choose_type') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="E" data-value-label="{{ t('common.types.expense') }}" aria-selected="false">
                            {{ t('common.types.expense') }}
                        </button>
                        <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="I" data-value-label="{{ t('common.types.income') }}" aria-selected="false">
                            {{ t('common.types.income') }}
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="transaction-amount">{{ t('common.fields.amount') }}</label>
                    <input id="transaction-amount" name="amount" type="text" inputmode="decimal" value="0,00" data-type="required" class="mt-1 h-[29px] w-full bg-transparent leading-[21px] outline-none" autocomplete="off">
                </div>
            </div>

            <div class="form-group">
                <label for="transaction-title">{{ t('common.fields.title') }}</label>
                <input id="transaction-title" name="title" type="text" data-type="required" class="mt-1 w-full bg-transparent outline-none" autocomplete="off">
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                {# Declara o combobox de wallet da transação #}
                <div class="form-group" data-select data-select-name="wallet" data-select-placeholder="{{ t('common.placeholders.choose_wallet') }}">
                    <label>{{ t('common.fields.wallet') }}</label>
                    <input type="hidden" name="wallet_id" data-type="required" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.choose_wallet') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        {% for wallet in transaction_wallets|default([]) %}
                            <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ wallet.id|e('html_attr') }}" data-value-label="{{ wallet.name|e('html_attr') }}" aria-selected="false">
                                {{ wallet.name }}
                            </button>
                        {% endfor %}
                    </div>
                </div>

                {# Declara o combobox de categoria da transação #}
                <div class="form-group" data-select data-select-name="category" data-select-placeholder="{{ t('common.placeholders.choose_category') }}">
                    <label>{{ t('common.fields.category') }}</label>
                    <input type="hidden" name="category_id" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.choose_category') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        {% for category in transaction_categories|default([]) %}
                            <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ category.id|e('html_attr') }}" data-value-label="{{ category.name|e('html_attr') }}" aria-selected="false">
                                {{ category.name }}
                            </button>
                        {% endfor %}
                    </div>
                </div>

                {# Declara o combobox de entidade da transação #}
                <div class="form-group" data-select data-select-name="entity" data-select-placeholder="{{ t('common.placeholders.choose_entity') }}">
                    <label>{{ t('common.fields.entity') }}</label>
                    <input type="hidden" name="entity_id" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.choose_entity') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        {% for entity in transaction_entities|default([]) %}
                            <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ entity.id|e('html_attr') }}" data-value-label="{{ entity.name|e('html_attr') }}" aria-selected="false">
                                {{ entity.name }}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {# Declara o combobox de template da transação #}
                <div class="form-group" data-select data-select-name="template" data-select-placeholder="{{ t('common.placeholders.no_template') }}">
                    <label>{{ t('common.fields.template') }}</label>
                    <input type="hidden" name="template_id" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.no_template') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        {% for template in transaction_templates|default([]) %}
                            <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ template.id|e('html_attr') }}" data-value-label="{{ template.title|e('html_attr') }}" data-template-type="{{ template.type|e('html_attr') }}" data-template-wallet-id="{{ template.wallet.id|e('html_attr') }}" data-template-wallet-name="{{ template.wallet.name|e('html_attr') }}" data-template-category-id="{{ template.category.id|e('html_attr') }}" data-template-category-name="{{ template.category.name|e('html_attr') }}" data-template-entity-id="{{ template.entity.id|e('html_attr') }}" data-template-entity-name="{{ template.entity.name|e('html_attr') }}" data-template-amount="{{ template.amount|e('html_attr') }}" data-template-month-day="{{ template.month_day|e('html_attr') }}" data-template-defines-cycle="{{ template.defines_cycle|default(0)|e('html_attr') }}" aria-selected="false">
                                {{ template.title }}
                            </button>
                        {% endfor %}
                    </div>
                </div>

                {# Declara o combobox da forma de pagamento da transação #}
                <div class="form-group" data-select data-select-name="payment-method" data-select-placeholder="{{ t('common.placeholders.choose_payment_method') }}">
                    <label>{{ t('common.fields.payment_method') }}</label>
                    <input type="hidden" name="payment_method_id" data-select-input>
                    <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                        <span data-select-label class="text-sm">{{ t('common.placeholders.choose_payment_method') }}</span>
                        <i class="fa-solid fa-chevron-down text-primary"></i>
                    </button>
                    <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                        {% for method in transaction_payment_methods|default([]) %}
                            <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ method.id|e('html_attr') }}" data-value-label="{{ method.name|e('html_attr') }}" aria-selected="false">
                                {{ method.name }}
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="form-group">
                    <label for="transaction-occurrence-date">{{ t('common.fields.date') }}</label>
                    <input id="transaction-occurrence-date" name="occurrence_date" type="date" data-type="required" class="mt-1 h-[29px] w-full bg-transparent leading-[21px] outline-none">
                </div>
                <div class="form-group">
                    <label for="transaction-due-date">{{ t('common.fields.due_date') }}</label>
                    <input id="transaction-due-date" name="due_date" type="date" class="mt-1 h-[29px] w-full bg-transparent leading-[21px] outline-none">
                </div>
                <div class="form-group">
                    <label for="transaction-paid-at">{{ t('common.fields.paid_at') }}</label>
                    <input id="transaction-paid-at" name="paid_at" type="date" class="mt-1 h-[29px] w-full bg-transparent leading-[21px] outline-none">
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-5">
                <label class="flex cursor-pointer items-center gap-3 text-sm text-[var(--surface-contrast)]">
                    <input type="hidden" name="paid" value="0">
                    <input type="checkbox" name="paid" value="1" class="peer sr-only" data-transaction-paid-input>
                    <span class="flex h-5 w-5 items-center justify-center rounded border-[1.5px] border-[var(--primary)] text-[0px] text-light transition peer-checked:bg-[var(--primary)] peer-checked:text-xs">
                        <i class="fa-solid fa-check"></i>
                    </span>
                    {{ t('transactions.paid') }}
                </label>

                <label class="flex cursor-pointer items-center gap-3 text-sm text-[var(--surface-contrast)]">
                    <input type="hidden" name="defines_cycle" value="0">
                    <input type="checkbox" name="defines_cycle" value="1" class="peer sr-only" data-transaction-defines-cycle-input>
                    <span class="flex h-5 w-5 items-center justify-center rounded border-[1.5px] border-[var(--primary)] text-[0px] text-light transition peer-checked:bg-[var(--primary)] peer-checked:text-xs">
                        <i class="fa-solid fa-check"></i>
                    </span>
                    {{ t('transactions.defines_cycle') }}
                </label>
            </div>
        </div>

        <div class="flex justify-end gap-3 px-6 py-4">
            <button type="button" class="modal-close btn-secondary">
                {{ t('common.actions.cancel') }}
            </button>
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-check"></i>
                {{ t('common.actions.save') }}
            </button>
        </div>
    </form>
</dialog>
