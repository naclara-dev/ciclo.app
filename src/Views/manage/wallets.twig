{% extends 'layouts/app.twig' %}

{% block content %}
    <section class="grid grid-cols-1 md:grid-cols-2 items-end">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-primary text-3xl">
                    {{ t('manage.wallets.title') }}
                </h1>
                {# Define a dica contextual da tela de wallets #}
                <div class="info-hint-wrapper" data-info-hint>
                    <button type="button" class="flex h-7 w-7 items-center justify-center rounded text-secondary transition hover:text-[var(--primary)] focus-visible:bg-[var(--primary)] focus-visible:outline-none" aria-label="{{ t('manage.wallets.info_label') }}" aria-describedby="wallets-info-hint" aria-expanded="false" data-info-hint-toggle>
                        <i class="fa-regular fa-circle-question"></i>
                    </button>
                    <div id="wallets-info-hint" class="info-hint" role="tooltip">
                        {{ t('manage.wallets.tooltip') }}
                    </div>
                </div>
            </div>
            <p class="text-sm mt-2 text-secondary">
                {{ t('manage.wallets.description') }}
            </p>
        </div> 
        <div class="flex justify-end"> 
            <button type="button" class="modal-toggle btn-primary w-50 mt-4 text-xl" data-modal-target="#wallet-modal">
                <i class="fa-solid fa-plus fa-sm mr-1"></i>
                {{ t('common.actions.create') }}
            </button>
        </div> 
    </section> 

    <section class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-4">
        {% for wallet in wallets %}
            <div class="manage-card relative w-full">
                <button type="button" class="w-full pr-10 text-left" data-edit-wallet data-wallet-id="{{ wallet.id|e('html_attr') }}">
                    <div class="flex items-center gap-3">
                        <div class="manage-card-text">                
                            {{ wallet.name }}            
                        </div> 
                    </div>       
                </button>

                <form method="post" action="{{ base_url }}/manage/wallets/delete" class="absolute right-2 top-3">
                    <input type="hidden" name="id" value="{{ wallet.id|e('html_attr') }}">
                    <button type="submit" class="cursor-pointer flex h-8 w-8 items-center justify-center rounded text-secondary" aria-label="{{ t('manage.wallets.delete_label') }}" data-delete-button>
                        <i class="fa-regular fa-trash-can"></i>
                    </button>
                </form>
            </div>
        {% else %} 
            <p class="col-span-4 flex min-h-[calc(100vh-220px)] items-center justify-center text-center text-secondary text-3xl">
                {{ t('manage.wallets.empty') }} 
            </p>            
        {% endfor %}  
    </section>

    <dialog id="wallet-modal" class="modal fixed top-1/2 left-1/2 w-[min(92vw,650px)] -translate-x-1/2 -translate-y-1/2 scale-95 rounded-lg border border-[var(--secondary)] bg-[var(--surface)] p-0 text-[var(--surface-contrast)] opacity-0 shadow-xl transition duration-200 backdrop:bg-[var(--overlay)]" data-wallet-modal data-wallet-find-url="{{ base_url }}/manage/wallets/find">
        <form method="post" action="{{ base_url }}/manage/wallets/store" class="validate" data-wallet-form>
            <div class="flex items-center justify-between px-6 py-4">
                <div>
                    <h2 class="text-xl font-bold text-primary" data-wallet-modal-title>{{ t('manage.wallets.new') }}</h2>
                    <p class="mt-1 text-xs text-[var(--surface-contrast)] opacity-70">{{ t('manage.wallets.form_description') }}</p>
                </div>
                <button type="button" class="modal-close flex h-9 w-9 items-center justify-center rounded text-primary transition hover:bg-[var(--secondary)]" aria-label="{{ t('common.actions.close') }}">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-5 px-6 py-5">
                <input type="hidden" name="id" data-wallet-id-input>

                <div class="form-group">
                    <label for="wallet-name">{{ t('common.fields.name') }}</label>
                    <input id="wallet-name" name="name" type="text" data-type="required" class="mt-1 w-full bg-transparent outline-none" autocomplete="off" data-wallet-name-input>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {# Declara o combobox de tipo da wallet #}
                    <div class="form-group" data-select data-select-placeholder="{{ t('common.placeholders.choose_type') }}">
                        <label>{{ t('common.fields.type') }}</label>
                        <input type="hidden" name="type_id" data-type="required" data-select-input>

                        <button type="button" class="mt-1 flex h-[29px] w-full items-center justify-between rounded border-b-[1.5px] border-[var(--primary)] bg-transparent px-[7px] py-[3px] text-left leading-[21px] transition hover:border-[var(--primary)]" data-select-toggle aria-expanded="false">
                            <span data-select-label class="text-sm">
                                {{ t('common.placeholders.choose_type') }}
                            </span>
                            <i class="fa-solid fa-chevron-down text-primary"></i>
                        </button>

                        <div class="mt-2 max-h-0 overflow-hidden rounded border border-transparent bg-[var(--surface)] opacity-0 shadow-lg transition-all duration-200" data-select-menu>
                            {% for type in wallet_types %}
                                <button type="button" class="flex w-full items-center rounded px-3 py-2 text-left text-sm transition hover:bg-[var(--secondary)] hover:text-primary" data-select-option data-value="{{ type.id|e('html_attr') }}" data-value-label="{{ type.name|e('html_attr') }}" aria-selected="false">
                                    {{ type.name }}
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="wallet-initial-balance">{{ t('manage.wallets.initial_balance') }}</label>
                        <input id="wallet-initial-balance" name="initial_balance" type="text" inputmode="decimal" value="0,00" data-type="required" class="mt-1 h-[29px] w-full bg-transparent leading-[21px] outline-none" autocomplete="off" data-wallet-balance-input>
                    </div>
                </div>

                <label class="flex cursor-pointer items-center gap-3 text-sm text-[var(--surface-contrast)]">
                    <input type="hidden" name="active" value="0">
                    <input type="checkbox" name="active" value="1" checked class="peer sr-only" data-wallet-active-input>
                    <span class="flex h-5 w-5 items-center justify-center rounded border-[1.5px] border-[var(--primary)] text-[0px] text-light transition peer-checked:bg-[var(--primary)] peer-checked:text-xs">
                        <i class="fa-solid fa-check"></i>
                    </span>
                    ativo
                </label>
            </div>

            <div class="flex justify-end gap-3 px-6 py-4">
                <button type="button" class="modal-close btn-secondary">
                    {{ t('common.actions.cancel') }}
                </button>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-check"></i>
                    {{ t('common.actions.save') }}
                </button>
            </div>
        </form>
    </dialog>
{% endblock %}

{% block scripts %}
    <script src="{{ base_url }}/assets/js/wallets.js"></script>
{% endblock %}