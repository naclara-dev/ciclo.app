{% extends 'layouts/app.twig' %}

{% block content %}    
    <section class="grid grid-cols-1 md:grid-cols-2 items-end">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-primary text-3xl">
                    {{ t('manage.title') }}
                </h1>
                {# Define a dica contextual da tela de cadastros #}
                <div class="info-hint-wrapper" data-info-hint>
                    <button type="button" class="flex h-7 w-7 items-center justify-center rounded text-secondary transition hover:text-[var(--primary)] focus-visible:bg-[var(--primary)] focus-visible:outline-none" aria-label="{{ t('manage.info_label') }}" aria-describedby="manage-info-hint" aria-expanded="false" data-info-hint-toggle>
                        <i class="fa-regular fa-circle-question"></i>
                    </button>
                    <div id="manage-info-hint" class="info-hint" role="tooltip">
                        {{ t('manage.tooltip_intro') }}
                        {{ t('manage.tooltip_description') }}
                    </div>
                </div>
            </div>
            <p class="text-sm mt-2 text-secondary">
                {{ t('manage.description') }}
            </p>
        </div>  
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <a class="manage-card" href="{{ base_url }}/manage/categories">
            <div class="manage-card-icon">
                <i class="fa-regular fa-note-sticky fa-xl"></i>            
            </div>
            <div class="manage-card-content">
                <div class="manage-card-title">                
                    {{ t('manage.categories.title') }}            
                </div> 
                <div class="manage-card-text text-dark">
                    {{ t('manage.categories.description') }}
                </div> 
                <div class="manage-card-info">
                    <span class="badge">
                        {{ categories_count }}
                        {{ t('manage.categories.title') }}
                    </span>
                </div> 
            </div>       
        </a> 
        <a class="manage-card" href="{{ base_url }}/manage/wallets">
            <div class="manage-card-icon">
                <i class="fa-regular fa-envelope fa-xl"></i>
            </div>
            <div class="manage-card-content">
                <div class="manage-card-title">                
                    {{ t('manage.wallets.title') }}            
                </div> 
                <div class="manage-card-text">
                    {{ t('manage.wallets.description') }}
                </div> 
                <div class="manage-card-info">
                    <span class="badge">
                        {{ wallets_count }}
                        {{ t('manage.wallets.title') }}
                    </span>
                </div> 
            </div>       
        </a> 
        <a class="manage-card" href="{{ base_url }}/manage/entities">
            <div class="manage-card-icon">
                <i class="fa-regular fa-user fa-xl"></i>
            </div>
            <div class="manage-card-content">
                <div class="manage-card-title">                
                    {{ t('manage.entities.title') }}            
                </div> 
                <div class="manage-card-text">
                    crie e gerencie pessoas, grupos e organizações credoras.
                </div> 
                <div class="manage-card-info">
                    <span class="badge">
                        {{ entities_count }}
                        {{ t('manage.entities.title') }}
                    </span>
                </div> 
            </div>       
        </a> 
        <a class="manage-card" href="{{ base_url }}/manage/templates">
            <div class="manage-card-icon">
                <i class="fa-regular fa-file-lines fa-xl"></i>           
            </div>
            <div class="manage-card-content">
                <div class="manage-card-title">                
                    {{ t('manage.templates.title') }}            
                </div> 
                <div class="manage-card-text">
                    {{ t('manage.templates.description') }}
                </div> 
                <div class="manage-card-info">
                    <span class="badge">
                        {{ templates_count }}
                        {{ t('manage.templates.title') }}
                    </span>
                </div> 
            </div>       
        </a>          
    </section> 
{% endblock %}