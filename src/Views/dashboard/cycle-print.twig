<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ciclo {{ cycle.label }}</title>
    <link rel="icon" href="{{ base_url }}/assets/img/favicon.png" type="image/x-icon">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <style>
        :root {
            --primary: #52b5b2;
            --primary-contrast: #fffbe8;
            --secondary: #f8e9b6;
            --secondary-contrast: #52b5b2;
            --background: #fffbe8;
            --background-contrast: #3a3835;
            --surface: #fffff5;
            --surface-contrast: #3a3835;
            --muted: #e7d69c;
            --border: #f8e9b6;
            --print-background: #eee9d7;
            --shadow: rgba(58, 56, 53, 0.14);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--print-background);
            color: var(--surface-contrast);
            font-family: "Montserrat", sans-serif;
            font-size: 13px;
        }

        .print-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            padding: 18px;
        }

        .print-actions button {
            border: 0;
            border-radius: 3px;
            padding: 8px 14px;
            background: var(--primary);
            color: var(--background);
            cursor: pointer;
            font: inherit;
            font-weight: 600;
        }

        .print-sheet {
            width: min(210mm, calc(100% - 32px));
            min-height: 297mm;
            margin: 0 auto 24px;
            padding: 12mm;
            background: var(--surface);
            box-shadow: 0 8px 30px var(--shadow);
        }

        .cycle-table {
            width: 100%;
            border-collapse: collapse;
        }

        .cycle-table thead td {
            padding: 0 0 6mm;
        }

        .cycle-table tbody tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .cycle-table tbody td {
            padding: 0 0 3mm;
        }

        .cycle-heading {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: 14px;
        }

        .cycle-day {
            display: flex;
            width: 52px;
            height: 52px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--secondary);
            color: var(--primary);
            font-size: 18px;
            font-weight: 700;
        }

        .cycle-title {
            margin: 0;
            color: var(--primary);
            font-size: 22px;
            font-weight: 700;
        }

        .cycle-subtitle {
            margin: 4px 0 0;
            opacity: 0.65;
        }

        .transaction {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 14px;
            border: 1px solid var(--secondary);
            border-radius: 4px;
            padding: 10px 12px;
            background: var(--background);
        }

        .transaction.paid {
            opacity: 0.78;
        }

        .transaction-identity {
            display: flex;
            min-width: 0;
            align-items: center;
            gap: 10px;
        }

        .transaction-icon {
            display: flex;
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: var(--background);
        }

        .transaction-text {
            min-width: 0;
        }

        .transaction-title {
            margin: 0;
            overflow-wrap: anywhere;
            font-size: 13px;
            font-weight: 600;
        }

        .transaction-meta {
            margin: 3px 0 0;
            color: var(--muted);
            font-size: 10px;
        }

        .transaction-summary {
            min-width: 112px;
            text-align: right;
        }

        .transaction-date {
            display: block;
            color: var(--muted);
            font-size: 10px;
        }

        .transaction-amount {
            display: block;
            margin-top: 2px;
            font-size: 13px;
        }

        .transaction-amount.income {
            color: var(--primary);
        }

        .transaction-status {
            display: inline-block;
            margin-top: 3px;
            border-radius: 3px;
            padding: 2px 6px;
            background: var(--secondary);
            font-size: 9px;
        }

        .empty-state {
            border: 1px solid var(--secondary);
            border-radius: 4px;
            padding: 18px;
            background: var(--background);
            text-align: center;
        }

        @page {
            size: A4 portrait;
            margin: 10mm;
        }

        @media print {
            .print-actions {
                display: none;
            }

            body {
                background: var(--surface);
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }

            .print-sheet {
                width: auto;
                min-height: 0;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <nav class="print-actions" aria-label="Ações de impressão">
        <button type="button" onclick="window.print()">
            <i class="fa-solid fa-print"></i>
            imprimir ou salvar PDF
        </button>
        <button type="button" onclick="window.close()">
            fechar
        </button>
    </nav>

    <main class="print-sheet">
        <table class="cycle-table">
            <thead>
                <tr>
                    <td>
                        <div class="cycle-heading">
                            <div class="cycle-day">{{ cycle.startDayLabel }}</div>
                            <div>
                                <h1 class="cycle-title">{{ cycle.label }}</h1>
                                <p class="cycle-subtitle">lançamentos do ciclo financeiro</p>
                            </div>
                        </div>
                    </td>
                </tr>
            </thead>

            <tbody>
                {% for transaction in cycle.transactions %}
                    <tr>
                        <td>
                            <article class="transaction {% if transaction.paid %}paid{% endif %}">
                                <div class="transaction-identity">
                                    <div class="transaction-icon" style="background-color: {{ transaction.category.color|e('html_attr') }}">
                                        <i class="{{ transaction.category.icon|e('html_attr') }}"></i>
                                    </div>
                                    <div class="transaction-text">
                                        <h2 class="transaction-title">{{ transaction.title }}</h2>
                                        <p class="transaction-meta">{{ transaction.meta_label }}</p>
                                    </div>
                                </div>

                                <div class="transaction-summary">
                                    <span class="transaction-date">{{ transaction.date_label }}</span>
                                    <strong class="transaction-amount {% if transaction.amount > 0 %}income{% endif %}">{{ transaction.amount_label }}</strong>
                                    <span class="transaction-status">{{ transaction.status_label }}</span>
                                </div>
                            </article>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td>
                            <div class="empty-state">nenhum lançamento neste ciclo.</div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>

    <script>
        window.addEventListener('load', function () {
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(function () {
                    window.print();
                });
                return;
            }

            window.print();
        });
    </script>
</body>
</html>
