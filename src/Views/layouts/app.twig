<!DOCTYPE html>
<html lang="{{ current_language|default('pt-br') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="{{ base_url }}/assets/img/favicon.png" type="image/x-icon">
    <link rel="manifest" href="{{ base_url }}/manifest.json">
    <meta name="theme-color" content="#52b5b2">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Tailwind -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
    <!-- CSS -->
    <link rel="stylesheet" href="{{ base_url }}/assets/css/reset.css">
    <link rel="stylesheet" href="{{ base_url }}/assets/css/animations.css">
    <link rel="stylesheet" href="{{ base_url }}/assets/css/style.css">

    <title>{{ t('app.title') }}</title>
</head>
<body class="{% if dark_theme|default(false) %} dark {% endif %}">
    {% block sidebar %}
        {% if show_menu is not defined or show_menu %}
            {% include 'components/sidebar.twig' %}
        {% endif %}
    {% endblock %}

    <main class="page-content {% if show_menu is not defined or show_menu %}has-sidebar{% endif %} grow-1 {% if not no_padding %} p-5 lg:p-8 {% endif %}">
        {% block content %}
        {% endblock %}
    </main>

    {% include 'components/confirm-modal.twig' %}
    {% include 'components/transaction-modal.twig' %}

    <div class="global-loading-overlay" data-global-loading hidden aria-hidden="true">
        <span class="loading --primary global-loading-spinner" role="status" aria-label="{{ t('common.loading') }}"></span>
    </div>

    <script>
        window.CicloTranslations = {{ current_translations|json_encode|raw }};

        window.CicloTranslate = function (key, fallback) {
            // Define o ponto inicial da busca no catálogo ativo
            let value = window.CicloTranslations || {};

            // Percorre a chave em formato dot notation
            String(key).split('.').forEach(function (segment) {
                if (value && Object.prototype.hasOwnProperty.call(value, segment)) {
                    value = value[segment];
                    return;
                }

                value = null;
            });

            // Retorna o texto encontrado ou o fallback informado pelo JS
            return typeof value === 'string' ? value : fallback;
        };
    </script>
    <script src="{{ base_url }}/assets/js/utils/loading.js"></script>
    <script src="{{ base_url }}/assets/js/utils/validation.js"></script>
    <script src="{{ base_url }}/assets/js/utils/modal.js"></script>
    <script src="{{ base_url }}/assets/js/utils/select.js"></script>
    <script src="{{ base_url }}/assets/js/action.js?v=3"></script>   
    <script src="{{ base_url }}/assets/js/transactions.js"></script>
     
    {% block scripts %}{% endblock %}
</body>
</html>

